FROM nginx:alpine

LABEL maintainer="Local Development Environment"

# Create necessary directories
RUN mkdir -p /app/data /app/config

# Copy nginx configuration
COPY docker/local-dev/nginx.conf /etc/nginx/nginx.conf
COPY docker/local-dev/default.conf /etc/nginx/conf.d/default.conf

# Copy startup script
COPY docker/local-dev/start.sh /start.sh
RUN chmod +x /start.sh

# Create a simple index page
RUN echo '<html><body><h1>Nginx Proxy Manager - Local Dev</h1><p>Reverse proxy is running on HTTP</p></body></html>' > /usr/share/nginx/html/index.html

EXPOSE 80 81

WORKDIR /app

CMD ["/start.sh"]